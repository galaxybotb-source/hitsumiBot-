// También acepta link: global.canal = 'https://whatsapp.com/channel/XXXXXXXX'
global.canal = { jid: '120363412265734140@newsletter', name: '┊ᥫ᭡𝓗𝓲𝓽𝓼𝓾𝓶𝓲-𝓑𝓸𝓽 𝓒𝓱𝓪𝓷𝓷𝓮𝓵𖤐
' }

